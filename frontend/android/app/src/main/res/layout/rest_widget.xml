<?xml version="1.0" encoding="utf-8"?>
<!-- The rest timer on the cover screen: what it is, the clock, the bar, and the same four
     controls as the notification. Big, for a small screen read at arm's length. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rw_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/rw_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textColor="#FFAEAEB2"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/rw_clock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFeatureSettings="tnum"
        android:text="–:––"
        android:textColor="#FFFFFFFF"
        android:textSize="64sp"
        android:textStyle="bold" />

    <ProgressBar
        android:id="@+id/rw_bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:layout_marginTop="8dp"
        android:max="100"
        android:progress="0"
        android:progressBackgroundTint="#3A3A3C"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/rw_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView android:id="@+id/rw_pause" style="@style/RestWidgetButton" />
        <TextView android:id="@+id/rw_minus" style="@style/RestWidgetButton" />
        <TextView android:id="@+id/rw_plus" style="@style/RestWidgetButton" />
        <TextView android:id="@+id/rw_skip" style="@style/RestWidgetButton" />
    </LinearLayout>
</LinearLayout>
